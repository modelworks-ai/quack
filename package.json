{
  "name": "@modelworks/quack",
  "version": "0.2.4",
  "description": "Launch AI coding agents (OpenCode, and more) with ModelWorks circuits as model providers. OAuth login, local proxy with auth injection, run history, and git-like project config.",
  "type": "module",
  "bin": {
    "quack": "dist/bin.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prebuild": "node scripts/build-info.mjs",
    "build": "tsc",
    "prepublishOnly": "node scripts/build-info.mjs && tsc",
    "dev": "tsc --watch",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "test:run": "node --test dist-test/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.5.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modelworks-ai/quack.git"
  },
  "homepage": "https://github.com/modelworks-ai/quack",
  "bugs": {
    "url": "https://github.com/modelworks-ai/quack/issues"
  },
  "dependencies": {
    "commander": "^15.0.0"
  }
}
